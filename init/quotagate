#!/bin/sh
### BEGIN INIT INFO
# Provides:          quotagate
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: QuotaGate antiX gateway and dashboard
### END INIT INFO
DAEMON=/opt/quotagate/venv/bin/python
PID=/run/quotagate.pid
LOGDIR=/var/log/quotagate
LOG=$LOGDIR/service.log
export PYTHONPATH=/opt/quotagate
case "$1" in
 start)
  [ "$(id -u)" -eq 0 ] || { echo "root required"; exit 1; }
  install -d -m 0700 /run/quotagate
  install -d -m 0750 "$LOGDIR"
  /usr/local/sbin/quotagate-network-start >>"$LOG" 2>&1 || { echo "QuotaGate network start failed; see $LOG"; exit 1; }
  [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && exit 0
  start-stop-daemon --start --background --make-pidfile --pidfile "$PID" --chdir /opt/quotagate --startas "$DAEMON" -- -m app.main >>"$LOG" 2>&1
  ;;
 stop)
  start-stop-daemon --stop --retry=TERM/10/KILL/5 --pidfile "$PID" 2>/dev/null || true
  rm -f "$PID"
  /usr/local/sbin/quotagate-network-stop >>"$LOG" 2>&1 || true
  rm -rf /run/quotagate
  ;;
 restart) "$0" stop; sleep 1; "$0" start ;;
 status)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then echo "quotagate is running as root"; exit 0; fi
  echo "quotagate is stopped"; exit 3 ;;
 *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
